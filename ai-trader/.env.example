# ---- LLM ----
ANTHROPIC_API_KEY=
MODEL_FAST=claude-haiku-4-5-20251001
MODEL_SMART=claude-sonnet-4-6
COMPETITION_MODEL_API_KEY=          # optional 2nd model (DeepSeek/Qwen) for model-competition

# ---- Broker (Alpaca) ----
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
EXECUTION_BACKEND=paper             # paper | alpaca_sdk | alpaca_mcp

# ---- Data (optional) ----
POLYGON_API_KEY=
FINANCIAL_DATASETS_API_KEY=

# ---- Master switches ----
TRADING_MODE=paper                  # paper | live
HUMAN_APPROVAL=true                 # require human approval before any LIVE order
STARTING_EQUITY_USD=100000

# ---- Hard risk limits (RiskGuard — enforced in code) ----
MAX_POSITION_USD=2000
MAX_TRADE_PCT=2
DAILY_MAX_LOSS_USD=200
SAFETY_MODE_MAX_CONSEC_LOSSES=3
MAX_OPTIONS_LEVEL=2
ALLOWED_SYMBOLS=AAPL,MSFT,NVDA,SPY
MARKET_HOURS_ONLY=true

# ---- Optional feature flags (default off) ----
ENABLE_PERSONAS=false
ENABLE_MODEL_COMPETITION=false
ENABLE_POLYMARKET=false
ENABLE_FINRL=false
ENABLE_FUNDAMENTALS=true             # fundamentals/news analyst (mock unless FINANCIAL_DATASETS_API_KEY set)
ENABLE_SENTIMENT=true                # sentiment sub-agent over the news feed (lexicon, offline)

# ---- Webhook / API auth (NEVER ship no-auth) ----
TRADINGVIEW_WEBHOOK_SECRET=
API_AUTH_TOKEN=
