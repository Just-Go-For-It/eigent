# Congress Trading Aggregator — environment variables
# Copy this to .env and fill in your values

# --- Optional API Keys (free sources work without) ---
# Get free key at https://finnhub.io/register (required for Finnhub data)
FINNHUB_API_KEY=

# Paid plan ~$30/mo at https://www.quiverquant.com/ (optional, richest data)
QUIVER_API_KEY=

# --- Configuration ---
LOOKBACK_DAYS=7          # Days of trading history to pull
REPORTS_DIR=congress_tracker/reports

# --- Schedule (daemon mode) ---
RUN_HOUR=7               # UTC hour (0-23)
RUN_MINUTE=0             # UTC minute (0-59)

# --- Email Digest (optional) ---
SEND_EMAIL=false
EMAIL_TO=your@email.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
